# Database
POSTGRES_HOST_PORT=5433
POSTGRES_DB=bulk_email
POSTGRES_USER=bulk_email_user
POSTGRES_PASSWORD=changeme_strong_password_here
DATABASE_URL=postgresql://bulk_email_user:changeme_strong_password_here@postgres:5432/bulk_email

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=changeme_refresh_secret_at_least_32_chars

# Admin (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_admin_password

# Server
PORT=3001
NODE_ENV=development
HTTP_HOST_PORT=8080
HTTPS_HOST_PORT=8443

# Client
VITE_API_URL=http://localhost:3001/api/v1

# Tracking
TRACKING_DOMAIN=https://track.yourdomain.com

# OpenAI email content generation (backend only; never expose this as VITE_*)
AI_EMAIL_GENERATION_ENABLED=true
AI_EMAIL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_EMAIL_MODEL=llama-3.1-8b-instant
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_MS=60000

# WhatsApp/Senqo integration bridge (generate a separate random secret)
SENQO_SSO_SHARED_SECRET=

# Senqo sidecar (start with: docker compose -f docker-compose.yml -f docker-compose.whatsapp.yml --profile whatsapp up -d --build)
# The same Postgres instance is used with an isolated `senqo` schema.
SENQO_DATABASE_URL=postgresql://bulk_email_user:changeme_strong_password_here@postgres:5432/senqo
MODEL_PROVIDER=openai
OPENAI_CHAT_LLM=gpt-4o-mini
OPENAI_FORMATTER_LLM=gpt-4o-mini
# Groq (set MODEL_PROVIDER=groq to use)
GROQ_API_KEY=
GROQ_CHAT_LLM=qwen/qwen3.6-27b
GROQ_FORMATTER_LLM=qwen/qwen3.6-27b
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local
SMTP_PASS=local
SMTP_FROM_EMAIL=noreply@localhost
WHATSAPP_SERVICE_API_KEY=
WHATSAPP_WEBHOOK_AUTHORIZATION=
API_KEY_PEPPER=
WORKSPACE_SECRETS_KEY=
S3_BUCKET=senqo-wa
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SENQO_FRONTEND_URL=http://localhost:8080/whatsapp/
SENQO_APP_URL=http://senqo-backend:3001
ALLOWED_PRODUCTION_ORIGINS=localhost
SENQO_AUTOMATION_WEBHOOK_URL=
SENQO_AUTOMATION_WEBHOOK_SECRET=
SENQO_OUTBOX_MAX_ATTEMPTS=8

# Gmail SMTP (configure in dashboard Settings)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AWS SES (configure in dashboard Settings)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=cadencerelay-production
SES_EVENT_QUEUE_URL=
SES_SNS_VERIFY_SIGNATURE=true

# Adaptive sending safety policy (rates are fractions, e.g. 0.05 = 5%)
ADAPTIVE_RATE_WINDOW_SIZE=100
ADAPTIVE_RATE_MIN_PER_SECOND=1
ADAPTIVE_RATE_INCREASE_FACTOR=1.10
ADAPTIVE_RATE_DECREASE_FACTOR=0.50
ADAPTIVE_RATE_SEVERE_DECREASE_FACTOR=0.25
ADAPTIVE_THROTTLE_DECREASE_RATE=0.01
ADAPTIVE_DELAY_DECREASE_RATE=0.05
ADAPTIVE_FAILURE_DECREASE_RATE=0.02
CAMPAIGN_BOUNCE_PAUSE_RATE=0.05
CAMPAIGN_COMPLAINT_PAUSE_RATE=0.001

# Campaign governance. Set both true only for a single-admin installation.
CAMPAIGN_APPROVAL_REQUIRED=false
CAMPAIGN_ALLOW_SELF_APPROVAL=false
